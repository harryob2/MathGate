<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp"
        android:paddingTop="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MathGate"
            android:textSize="30sp"
            android:textColor="@color/textPrimary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Do one Math Academy task to unlock your apps"
            android:textSize="14sp"
            android:textColor="@color/textTertiary"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS"
                android:textSize="11sp"
                android:textColor="@color/textTertiary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking Math Academy…"
                android:textSize="15sp"
                android:textColor="@color/textPrimary"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnCheckNow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_surface"
                android:text="Check now"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- Setup card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SETUP"
                android:textSize="11sp"
                android:textColor="@color/textTertiary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Blocking enabled"
                        android:textSize="15sp"
                        android:textColor="@color/textPrimary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Needs the accessibility service, a signed-in Math Academy account and at least one blocked app"
                        android:textSize="13sp"
                        android:textColor="@color/textSecondary" />

                </LinearLayout>

                <Switch
                    android:id="@+id/switchEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnAccessibility"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_surface"
                android:text="Accessibility service"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical|start"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnBattery"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_surface"
                android:text="Battery optimisation"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical|start"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnSelectApps"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_surface"
                android:text="Select blocked apps"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical|start"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvBlockedApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No blocked apps selected."
                android:textSize="14sp"
                android:textColor="@color/textSecondary"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/tvBrowserWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your default browser is in the blocked list, so the “Open Math Academy” shortcut on the block screen will be hidden."
                android:textSize="13sp"
                android:textColor="@color/negative"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Account card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MATH ACADEMY ACCOUNT"
                android:textSize="11sp"
                android:textColor="@color/textTertiary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvAccountStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Not signed in."
                android:textSize="14sp"
                android:textColor="@color/textSecondary"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_surface"
                android:hint="Username or email"
                android:inputType="textEmailAddress|textNoSuggestions"
                android:importantForAutofill="no"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_surface"
                android:hint="Password"
                android:inputType="textPassword"
                android:importantForAutofill="no"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_accent"
                android:text="Sign in &amp; test"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnSignOut"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_danger"
                android:text="Sign out &amp; forget password"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Reset card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAILY RESET"
                android:textSize="11sp"
                android:textColor="@color/textTertiary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apps lock again at this time every day until you complete a new Math Academy task."
                android:textSize="13sp"
                android:textColor="@color/textSecondary"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnResetTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_surface"
                android:text="Reset time: 04:00"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical|start" />

        </LinearLayout>

        <Button
            android:id="@+id/btnDumpTasks"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_surface"
            android:text="Debug: dump raw tasks to logcat"
            android:textColor="@color/textSecondary"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
